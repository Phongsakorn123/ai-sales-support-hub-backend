APP_NAME=AI Sales Support Hub API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_PATH=data/app.db
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# AI product suggestion agent (OpenRouter). Leave empty to disable; the endpoint then returns 503.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
