APP_NAME=AI Sales Support Hub API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_PATH=data/app.db
# Docker Compose generates and persists a random JWT secret when this is empty.
# For direct local API runs, set a random value of at least 32 characters.
JWT_SECRET_KEY=

# AI product suggestion agent (OpenRouter). Leave empty to use labelled catalog fallback results.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30

# Local multilingual embeddings (downloaded once to persistent data/fastembed).
SEMANTIC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_EMBEDDING_CACHE_DIR=data/fastembed
RETRIEVAL_RRF_K=60
RETRIEVAL_KEYWORD_WEIGHT=1.0
RETRIEVAL_SEMANTIC_WEIGHT=1.0
